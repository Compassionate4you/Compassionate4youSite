# ===================================
# Database Credentials
# ===================================

# Get these from: Supabase Dashboard → Connect → ORMs → Prisma
# DATABASE_URL: pooled connection (used by the running app)
# DIRECT_URL: direct connection (used for migrations)
DATABASE_URL="postgresql://postgres.kyttwlsecgoyogiqfwgz:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.kyttwlsecgoyogiqfwgz:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ===================================
# Authorization Configs
# ===================================

# Secret used to sign session tokens. Use a long random string per environment.
JWT_SECRET=change-me-to-a-long-random-string

# Origin allowed to send credentialed requests to the API.
CLIENT_ORIGIN=http://localhost:5173

AUTH0_DOMAIN=your-auth0-domain.us.auth0.com
AUTH0_AUDIENCE=your-api-identifier

# ===================================
# Ports
# ===================================

PORT=5000