// prisma-client-js emits CommonJS into node_modules/.prisma/client, which the
// server can require directly. The newer prisma-client generator emits
// TypeScript and would need a build step.
generator client {
  provider = "prisma-client-js"
}

// Connection URLs live in prisma.config.ts, not here (Prisma 7).
datasource db {
  provider = "postgresql"
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  password          String
  resetToken        String?   @unique
  resetTokenExpiry  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  appointments Appointment[]
}

// DT-563: appointments booked through the scheduling page.
enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Appointment {
  id String @id @default(uuid())

  // DT-564: set for logged-in users, null when a visitor books without an account.
  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Contact details as entered on the form, kept even for guest bookings.
  fullName String @map("full_name")
  email    String
  phone    String?

  // 'Home Health' | 'Hospice Care' | 'Consultation'
  serviceType String @map("service_type")

  // Date and slot are stored as entered so the form round-trips exactly.
  date     String
  timeSlot String @map("time_slot")

  notes  String?
  status AppointmentStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // DT-563: one slot per day cannot be booked twice.
  @@unique([date, timeSlot])
  @@index([userId])
  @@index([date])
  @@map("appointments")
}

// DT-397: chatbot history. userId is a plain string rather than a relation so
// it can be linked to User once accounts and chat sessions are tied together.
model ChatSession {
  id String @id @default(uuid())

  // Browser-generated session id, sent by the client on every request.
  clientSessionId String @unique @map("client_session_id")

  // Null for guests.
  userId String? @map("user_id")

  startedAt    DateTime @default(now()) @map("started_at")
  lastActiveAt DateTime @updatedAt @map("last_active_at")

  messages ChatMessage[]

  @@index([userId])
  @@map("chat_sessions")
}

model ChatMessage {
  id String @id @default(uuid())

  sessionId String      @map("session_id")
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // 'user' or 'bot'
  sender String
  body   String

  createdAt DateTime @default(now()) @map("created_at")

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}
