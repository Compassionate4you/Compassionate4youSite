// prisma-client-js emits CommonJS into node_modules/.prisma/client, which the
// server can require directly. The newer prisma-client generator emits
// TypeScript and would need a build step.
generator client {
  provider = "prisma-client-js"
}

// Connection URLs live in prisma.config.ts, not here (Prisma 7).
datasource db {
  provider = "postgresql"
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  password          String
  resetToken        String?   @unique
  resetTokenExpiry  DateTime?
  name              String?
  phone             String?
  role              String    @default("customer")
  accountStatus     String    @default("active")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  appointments Appointment[]
}

// DT-563: appointments booked through the scheduling page.
enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Appointment {
  id String @id @default(uuid())

  // DT-564: set for logged-in users, null when a visitor books without an account.
  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Contact details as entered on the form, kept even for guest bookings.
  fullName String @map("full_name")
  email    String
  phone    String?

  // 'Home Health' | 'Hospice Care' | 'Consultation'
  serviceType String @map("service_type")

  // Date and slot are stored as entered so the form round-trips exactly.
  date     String
  timeSlot String @map("time_slot")

  notes  String?
  status AppointmentStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // DT-563: one slot per day cannot be booked twice.
  @@unique([date, timeSlot])
  @@index([userId])
  @@index([date])
  @@map("appointments")
}

// DT-397: chatbot history. userId is a plain string rather than a relation so
// it can be linked to User once accounts and chat sessions are tied together.
model ChatSession {
  id String @id @default(uuid())

  // Browser-generated session id, sent by the client on every request.
  clientSessionId String @unique @map("client_session_id")

  // Null for guests.
  userId String? @map("user_id")

  startedAt    DateTime @default(now()) @map("started_at")
  lastActiveAt DateTime @updatedAt @map("last_active_at")

  messages ChatMessage[]

  @@index([userId])
  @@map("chat_sessions")
}

model ChatMessage {
  id String @id @default(uuid())

  sessionId String      @map("session_id")
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // 'user' or 'bot'
  sender String
  body   String

  createdAt DateTime @default(now()) @map("created_at")

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}
enum CardLayout {
  IMAGE_FULL_WIDTH
  HEADER_PARAGRAPH
  HEADER_SYMBOL
}

model CardSection {
  id String @id @default(uuid())
  slug String @unique
  page String
  title Json @default("{}")
  rows      Int @default(1)
  columns   Int @default(3)
  cardCount Int @default(3) @map("card_count")
  position Int @default(0)
  cards Card[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([page, position])
  @@map("card_sections")
}

model Card {
  id String @id @default(uuid())
  sectionId String      @map("section_id")
  section   CardSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  position Int
  layoutType CardLayout @map("layout_type")
  header    Json    @default("{}")
  paragraph Json    @default("{}")
  imageUrl  String? @map("image_url")
  imageAlt  Json    @default("{}") @map("image_alt")
  symbol String?
  alignment String @default("left")

  @@index([sectionId, position])
  @@map("cards")
}